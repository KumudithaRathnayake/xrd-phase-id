reference_library/_failed_queries.json
reference_library/CoRE_MOF/          # large; import it yourself (section 0 of the notebook)
reference_library/QMOF/              # large; import it yourself (section 0 of the notebook)
reference_library/CSD/               # CCDC licence does not allow redistribution
reference_library/Published/         # CIFs from journals' supporting information

# Python / Jupyter clutter
__pycache__/
*.pyc
.ipynb_checkpoints/

# Secrets
.env
*.key

# Office lock files
~$*
